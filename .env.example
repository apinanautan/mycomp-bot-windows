# Windows template. The app creates the real config at
# %LOCALAPPDATA%\MyComp Bot\.env; keep that local file private.
MYCOMP_ALLOWED_ROOTS=%USERPROFILE%\Documents,%USERPROFILE%\Desktop,%USERPROFILE%\Downloads
MYCOMP_SCHEMA_VERSION=4
MYCOMP_PERMISSION_LEVEL=normal
MYCOMP_AUTH_MODE=oauth
MYCOMP_PUBLIC_BASE_URL=
MYCOMP_OAUTH_REDIRECT_URIS=
MYCOMP_ALLOW_SHELL=true
MYCOMP_ALLOWED_EXECUTABLES=C:\Windows\System32\cmd.exe,C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe
MYCOMP_SHELL_PATH=C:\Windows\System32;C:\Windows;C:\Windows\System32\WindowsPowerShell\v1.0
MYCOMP_SHELL_FOREGROUND_TIMEOUT_SECONDS=120
MYCOMP_SHELL_AUTO_WAIT_SECONDS=5
MYCOMP_BROWSER_CDP_ENABLED=true
MYCOMP_BROWSER_CDP_PORT=9222
